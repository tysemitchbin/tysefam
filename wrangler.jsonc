{
  // Cloudflare deploy for the whole family site (`npm run deploy`).
  // Serves the repo as a static site; .assetsignore lists what stays private.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tysefam",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  }
}
